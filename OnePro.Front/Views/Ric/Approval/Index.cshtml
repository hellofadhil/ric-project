@using OnePro.Front.Models
@using OnePro.Front.Helpers
@using Core.Models.Enums

@model List<RicItemResponse>

@{
    ViewData["Title"] = "RIC Approval";
    Layout = "_LayoutDashboard";

    var total = Model?.Count ?? 0;
}

<div class="max-w-6xl mx-auto mt-6">

    <div class="bg-white border border-gray-200 shadow-xl rounded-3xl p-5 md:p-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div>
                <h1 class="text-2xl font-semibold text-gray-900">RIC Approval</h1>
                <p class="text-sm text-gray-500 mt-1">Daftar RIC yang masuk tahap approval. Pilih satu buat approve.</p>
            </div>

            <a asp-action="UserIndex"
               class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-2xl
                      border border-gray-200 hover:bg-gray-50 text-gray-800 transition">
                <i class="ri-arrow-left-line text-lg"></i>
                Back to My RIC
            </a>
        </div>
    </div>

    <div class="mt-5 bg-white border border-gray-200 shadow-lg rounded-3xl p-4 md:p-5">
        <div class="flex flex-col md:flex-row md:items-end gap-3 md:gap-4">
            <div class="flex-1">
                <label class="text-xs text-gray-500">Search (judul / user / id)</label>
                <div class="mt-1 relative">
                    <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input id="ricSearch"
                           type="text"
                           placeholder="Ketik buat cari..."
                           class="w-full pl-10 pr-3 py-2.5 rounded-2xl border border-gray-200
                                  focus:outline-none focus:ring-2 focus:ring-red-500/30 focus:border-red-300
                                  text-sm" />
                </div>
            </div>

            <div class="w-full md:w-72">
                <label class="text-xs text-gray-500">Filter Status (Approval)</label>
                <select id="statusFilter"
                        class="mt-1 w-full px-3 py-2.5 rounded-2xl border border-gray-200
                               focus:outline-none focus:ring-2 focus:ring-red-500/30 focus:border-red-300
                               text-sm">
                    <option value="">All</option>
                    <option value="@StatusRic.Approval_Manager_User">@StatusRic.Approval_Manager_User</option>
                    <option value="@StatusRic.Approval_VP_User">@StatusRic.Approval_VP_User</option>
                    <option value="@StatusRic.Approval_Manager_BR">@StatusRic.Approval_Manager_BR</option>
                    <option value="@StatusRic.Approval_Manager_SARM">@StatusRic.Approval_Manager_SARM</option>
                    <option value="@StatusRic.Approval_VP_SARM">@StatusRic.Approval_VP_SARM</option>
                    <option value="@StatusRic.Approval_Manager_ECS">@StatusRic.Approval_Manager_ECS</option>
                    <option value="@StatusRic.Approval_VP_ECS">@StatusRic.Approval_VP_ECS</option>
                </select>
            </div>

            <button id="clearFilter"
                    type="button"
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl
                           border border-gray-200 hover:bg-gray-50 text-sm font-medium transition">
                <i class="ri-refresh-line"></i>
                Reset
            </button>
        </div>
    </div>

    <div class="mt-5 bg-white border border-gray-200 shadow-xl rounded-3xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-left text-gray-700">
                <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                    <tr>
                        <th scope="col" class="px-5 py-4 w-40">ID</th>
                        <th scope="col" class="px-5 py-4">Judul</th>
                        <th scope="col" class="px-5 py-4">User PIC</th>
                        <th scope="col" class="px-5 py-4 w-44">Status</th>
                        <th scope="col" class="px-5 py-4 w-40">Last Update</th>
                        <th scope="col" class="px-5 py-4 w-44 text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="ricTableBody" class="divide-y divide-gray-100 bg-white">
                    @if (Model?.Any() == true)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/80 transition-colors duration-150"
                                data-status="@item.Status"
                                data-search="@($"{item.Id} {item.Judul} {item.UserName} {item.Status}").ToLower()">

                                <td class="px-5 py-4 text-xs text-gray-500 font-mono">
                                    <div class="truncate max-w-[7rem]" title="@item.Id">@item.Id</div>
                                </td>

                                <td class="px-5 py-4">
                                    <div class="font-semibold text-gray-900" title="@item.Judul">
                                        @(item.Judul?.Length > 50 ? item.Judul.Substring(0, 50) + "..." : item.Judul)
                                    </div>
                                </td>

                                <td class="px-5 py-4 text-gray-700">
                                    <div class="font-medium">@item.UserName</div>
                                </td>

                                <td class="px-5 py-4">
                                    <span class="@GetStatusBadgeClass(item.Status) px-2.5 py-1 rounded-full text-xs font-semibold">
                                        @item.Status
                                    </span>
                                </td>

                                <td class="px-5 py-4 text-gray-600 text-xs">
                                    <div class="inline-flex items-center gap-2">
                                        <i class="ri-time-line text-gray-400"></i>
                                        @item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>

                                <td class="px-5 py-4">
                                    <div class="flex items-center justify-center gap-2">
                                        <a asp-action="Approval" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl
                                                  bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition"
                                           title="Open Approval">
                                            <i class="ri-shield-check-line text-base"></i>
                                            Approval
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <div class="w-14 h-14 rounded-2xl bg-gray-50 border border-gray-200 flex items-center justify-center">
                                        <i class="ri-inbox-line text-3xl text-gray-300"></i>
                                    </div>
                                    <p class="text-gray-700 font-semibold">Belum ada RIC yang perlu di-approve.</p>
                                    <p class="text-gray-500 text-sm">Kalau udah masuk approval stage, bakal muncul di sini 😉</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="px-5 py-4 border-t border-gray-100 text-xs text-gray-500 flex items-center justify-between">
            <div class="inline-flex items-center gap-2">
                <i class="ri-information-line"></i>
                Tip: pakai Search + Filter biar cepet nemu.
            </div>
            <div class="font-medium">
                Showing <span id="shownCount">@total</span> of @total
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const searchInput = document.getElementById('ricSearch');
        const statusFilter = document.getElementById('statusFilter');
        const clearBtn = document.getElementById('clearFilter');
        const tbody = document.getElementById('ricTableBody');
        const shownCount = document.getElementById('shownCount');
        if (!searchInput || !statusFilter || !clearBtn || !tbody) return;

        const rows = Array.from(tbody.querySelectorAll('tr[data-search]'));

        function applyFilter() {
            const q = (searchInput.value || '').trim().toLowerCase();
            const s = (statusFilter.value || '').trim();

            let visible = 0;

            rows.forEach(r => {
                const hay = r.getAttribute('data-search') || '';
                const st = r.getAttribute('data-status') || '';
                const okQ = !q || hay.includes(q);
                const okS = !s || st === s;

                const show = okQ && okS;
                r.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            if (shownCount) shownCount.textContent = visible;
        }

        searchInput.addEventListener('input', applyFilter);
        statusFilter.addEventListener('change', applyFilter);
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            statusFilter.value = '';
            applyFilter();
        });

        applyFilter();
    })();
</script>
}

@functions {
    private string GetStatusBadgeClass(string status)
    {
        // khusus approval stage
        return status switch
        {
            "Approval_Manager_User" => "bg-amber-100 text-amber-800 border border-amber-200",
            "Approval_VP_User"      => "bg-orange-100 text-orange-800 border border-orange-200",
            "Approval_Manager_BR"   => "bg-indigo-100 text-indigo-800 border border-indigo-200",
            "Approval_Manager_SARM" => "bg-purple-100 text-purple-800 border border-purple-200",
            "Approval_VP_SARM"      => "bg-fuchsia-100 text-fuchsia-800 border border-fuchsia-200",
            "Approval_Manager_ECS"  => "bg-sky-100 text-sky-800 border border-sky-200",
            "Approval_VP_ECS"       => "bg-blue-100 text-blue-800 border border-blue-200",
            _                       => "bg-gray-100 text-gray-600 border border-gray-200"
        };
    }
}
