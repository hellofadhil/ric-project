@using OnePro.Front.Models
@using Core.Models.Enums

@model RicDetailResponse

@{
    ViewData["Title"] = "RIC Approval Detail";
    Layout = "_LayoutDashboard";
}

<div class="max-w-5xl mx-auto mt-6">

    <div class="bg-white border border-gray-200 shadow-xl rounded-3xl p-5 md:p-6">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
            <div>
                <h1 class="text-2xl font-semibold text-gray-900">Approval RIC</h1>
                <p class="text-sm text-gray-500 mt-1">Cek detail RIC lalu approve kalau udah aman.</p>
                <div class="mt-3 text-xs text-gray-500 font-mono">ID: @Model.Id</div>
            </div>

            <div class="flex items-center gap-2">
                <a asp-action="ApprovalIndex"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl
                          border border-gray-200 hover:bg-gray-50 text-sm font-medium transition">
                    <i class="ri-arrow-left-line"></i>
                    Back
                </a>

                <form asp-action="ApproveAction" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl
                                   bg-green-600 hover:bg-green-700 text-white text-sm font-semibold transition"
                            onclick="return confirm('Yakin mau approve RIC ini?');">
                        <i class="ri-check-line text-lg"></i>
                        Approve
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mt-4 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-700 text-sm">
            <i class="ri-checkbox-circle-line"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mt-4 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="mt-5 bg-white border border-gray-200 shadow-xl rounded-3xl p-5 md:p-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-xs text-gray-500">Status</div>
                <div class="mt-1 inline-flex">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold border bg-gray-50 text-gray-700">
                        @((StatusRic)Model.Status)
                    </span>
                </div>
            </div>
            @* <div class="text-right">
                <div class="text-xs text-gray-500">Updated</div>
                <div class="mt-1 text-sm font-medium text-gray-800">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div> *@
        </div>

        <div class="mt-6">
            <div class="text-xs text-gray-500">Judul</div>
            <div class="mt-1 text-lg font-semibold text-gray-900">@Model.Judul</div>
        </div>

        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-2xl border border-gray-200 p-4">
                <div class="text-xs text-gray-500">Permasalahan</div>
                <div class="mt-2 text-sm text-gray-800 whitespace-pre-line">@Model.Permasalahan</div>
            </div>
            <div class="rounded-2xl border border-gray-200 p-4">
                <div class="text-xs text-gray-500">Dampak Masalah</div>
                <div class="mt-2 text-sm text-gray-800 whitespace-pre-line">@Model.DampakMasalah</div>
            </div>
        </div>
    </div>
</div>
